# This repo is three independent projects (Research_Agent, Outreach_Agent,
# Dashboard), each with its own .gitignore for stack-specific ignores
# (__pycache__/, node_modules/, dist/, .venv/, etc). This root file only
# covers things that can appear at the repo root itself or that are common
# to all three and easy to commit by accident.

# Environment secrets -- every project's .env holds live API keys
# (Supabase service-role keys, SMTP credentials, Gemini/Anthropic/Groq/
# Tavily keys). Never commit these; only *.env.example files are tracked.
.env
.env.*
!.env.example
!*/.env.example

# Editors / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.idea_modules/
*.iml
.sublime-project
.sublime-workspace
.project
.pydevproject
.settings/
*.swp
*.swo
*~
.vscode-server/

# OS
.DS_Store
Thumbs.db
.Spotlight-V100
.Trashes
ehthumbs.db

# Python (in case anything is ever added at the root outside the agents)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Node (in case anything is ever added at the root outside Dashboard)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
package-lock.json.backup
dist/
dist-ssr/
*.local

# Build artifacts
build/
*.egg-info/

# Scratch space used by Claude Code sessions working in this repo
scratchpad/
.claude/

# Marketing/Demo artifacts
brag-output-*
*.demo.json

# Temporary files
*.tmp
*.bak
*~
.#*