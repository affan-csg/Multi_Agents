# Password for the Dashboard login (POST /auth/login). Fail closed: if unset,
# every protected route returns 503. Set the same value wherever Server runs
# (local shell, Render/Railway env). Never commit the real value.
DASHBOARD_PASSWORD=

# Optional comma-separated browser origins. The Vercel production origin is
# retained by default; add a custom domain here without changing code.
# CORS_ALLOWED_ORIGINS=https://multi-agents-beta.vercel.app,https://app.example.com

# Required for a Cloud Scheduler-triggered automation request. Store this in
# Secret Manager and send it as the X-Automation-Token header.
# AUTOMATION_TRIGGER_TOKEN=

# Optional -- origin the server advertises to itself for the
# Research<->Outreach hand-off URLs.
# CSG_API_BASE=http://127.0.0.1:8000
