# Required for everything -- the app has no local-storage fallback, every
# read/write goes through Supabase's PostgREST API using the service-role key
# (never a browser-exposed anon key). Get these from your Supabase project's
# Settings -> API page.
#
# When this agent runs standalone (its own uvicorn process), these are read
# directly. When it runs through the single-port server (Server/app.py,
# alongside the Outreach Agent in one process), that server instead reads
# this same value and republishes it as RESEARCH_SUPABASE_URL /
# RESEARCH_SUPABASE_SERVICE_KEY, so it can never collide with the Outreach
# Agent's own (separate) Supabase project in that shared process. No action
# needed here either way -- just fill in this project's own values.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Required for `csg discover` (autonomous company discovery + firmographic
# research) and `csg qualify` (LLM pain summary + recommended angle).
# Gemini (Google AI Studio, has a free tier) -- https://aistudio.google.com/apikey
GEMINI_API_KEY=
#
# Multi-key failover: add GEMINI_API_KEY_2, GEMINI_API_KEY_3, ... and the app
# automatically rotates to the next key once the current one's DAILY quota is
# exhausted (see src/csg/discovery/gemini_keys.py). A per-minute rate limit
# does not trigger rotation -- that's handled by retrying the same key.
# GEMINI_API_KEY_2=
#
# Note: discovery's "grounded search" (finding real companies via Google
# Search) has its own, much smaller free-tier daily quota than plain text
# generation used by qualify -- a key that works fine for `csg qualify` can
# still be fully out of quota for `csg discover`.
#
# Fallback discovery backend: if every GEMINI_API_KEY* is exhausted, discover
# automatically retries via Tavily (web search) + Groq (parses the search
# results into companies, no built-in search of its own). Both are optional --
# only needed when Gemini's discovery quota runs out.
# Tavily (has a free tier) -- https://tavily.com
TAVILY_API_KEY=
# Groq (has a free tier) -- https://console.groq.com/keys
GROQ_API_KEY=

# Optional -- alternative to Gemini for `csg qualify` only (not used by
# discovery). Gemini is tried first if both are set.
# Claude (Anthropic) -- https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional -- required only for `csg contacts` (HR/recruiting contact
# discovery via Hunter.io's Domain Search API). Free tier is a hard 25 domain
# searches PER MONTH (one call per company, not per contact). Get a key at
# https://hunter.io/api-keys
HUNTER_API_KEY=

# Optional -- where the Outreach Agent's API is running. When set, every
# research run automatically hands off its Tier A/B companies (after
# qualify + contacts) to Outreach: imported as prospects, and drafted into a
# campaign (never auto-sent -- sending is always a separate, later, manual
# step in the Outreach Agent). Unset means this hand-off is skipped entirely;
# nothing else about a research run changes. See icp.yaml's
# outreach.auto_qualify_top_n for the per-run cap on how many Tier A/B
# companies this covers.
#
# Running standalone (separate uvicorn processes): http://127.0.0.1:8001.
# Running through the single-port server (Server/app.py, recommended --
# see repo root README.md): http://127.0.0.1:8000/outreach. The server
# only enables the hand-off at all if this is set here (or in the real
# environment) -- it never turns it on by itself.
OUTREACH_API_BASE=http://127.0.0.1:8000/outreach
