# Where each agent's own FastAPI is running. The Dashboard calls these
# directly from the browser -- same pattern as each agent's own frontend --
# it has no backend/database of its own. Point these at different
# hosts/ports per environment without touching any agent's code.
VITE_RESEARCH_API_BASE=http://127.0.0.1:8000
VITE_OUTREACH_API_BASE=http://127.0.0.1:8001
