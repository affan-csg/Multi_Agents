# Required for everything -- the app has no local-storage fallback, every
# read/write goes through this Outreach project's own Supabase PostgREST API
# using the service-role key (never a browser-exposed anon key). This is a
# SEPARATE Supabase project from the Research Agent's -- get these from THIS
# project's Settings -> API page, not the Research Agent's.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Where the Research Agent's API is running -- Outreach pulls qualified
# prospects from here (GET /runs/{run_id}/companies, /companies/{domain}).
# Defaults to config/outreach.yaml's research.api_base if unset.
RESEARCH_API_BASE=http://127.0.0.1:8000

# Required to send email. Provider-agnostic SMTP config -- works with
# SendGrid/Postmark/SES/Gmail SMTP relay/etc, whichever you point it at.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
OUTREACH_FROM_EMAIL=
OUTREACH_FROM_NAME=CSG Outreach

# Required by the Conversation Agent (Agent 3) to DETECT replies. Point this
# at the same mailbox the SMTP settings above send from -- that is where
# replies land. Provider-agnostic, same as SMTP: Gmail, Outlook/365,
# Fastmail, a self-hosted Dovecot, whatever IMAP_HOST points at.
#
# For Gmail: host imap.gmail.com, port 993, and an App Password (NOT your
# account password) -- the same one you use for SMTP works here.
#
# Without these, the Conversation Agent still runs, but reports that IMAP is
# not configured instead of detecting replies -- it never fails silently.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Optional -- the scheduling link the Conversation Agent offers a prospect
# once they reply `interested` (see prompts/conversation_reply.md). Env var
# wins over outreach.yaml's personalization.calendly_url. Left blank, the
# reply asks for a few times that work instead of linking anywhere.
CALENDLY_URL=

# Optional -- LLM for message personalization (pain_summary/recommended_angle
# -> a drafted email) and for the Conversation Agent's reply/follow-up
# drafts. Three independent tiers, tried in order on any failure (not just a
# missing key): Gemini -> Anthropic -> Groq (plain text, no search) -- see
# personalize._call_llm. Without any of the three, a plain templated email is
# sent instead.
GEMINI_API_KEY=
# Optional additional Gemini keys, tried in order only after the previous
# key's DAILY quota is exhausted (a per-minute rate limit does not advance
# the pool) -- add as many as you have, numbered contiguously from _2. See
# src/outreach/gemini_keys.py.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional -- used only by the Redraft button's "go find more information"
# fallback (personalize.py's use_web_search tier), as a search-capable
# backend independent of the three above. Tavily does the actual web
# search, Groq turns the results into a draft -- same split the Research
# Agent's discovery/groq_tavily.py uses. Tried between Gemini+google_search
# and Anthropic+web_search; skipped (not an error) if either key is unset.
# Reuses GROQ_API_KEY above.
TAVILY_API_KEY=
